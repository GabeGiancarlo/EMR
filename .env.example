# Nexus API configuration. Every variable the API reads is listed here.
# Copy to .env for local use; on a host, enter the values as secrets/environment
# variables in the host's dashboard. This file must never contain a real value.

# ---------------------------------------------------------------- Mode
# local (default): loopback development. Operators are selected, not authenticated.
# oidc: hosted. Staff sign in through an identity provider. Required to listen on a
#       public address. The production image sets this to oidc.
NEXUS_AUTH_MODE=local

# Local mode only. Must be 1, and must be absent in hosted mode.
NEXUS_LOCAL_DEV=1

# ---------------------------------------------------------------- Server
# Local mode accepts only 127.0.0.1, ::1 or localhost. Hosted mode: 0.0.0.0.
HOST=127.0.0.1
# Many container hosts set PORT themselves; leave it to them when they do.
PORT=8090
# Required in hosted mode (no default). For a managed database add ?sslmode=require.
# Local mode defaults to the development database on 127.0.0.1:55432.
DATABASE_URL=
# Browser origins allowed to call the API: comma-separated, https, no path and no
# trailing slash, for example https://your-project.vercel.app
# Required in hosted mode. Local mode defaults to the Vite origin on port 5173.
NEXUS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- Sign-in (hosted mode)
# Provider requirement: its ID token must carry `email` and `email_verified: true`.
# A token without a verified-email statement is refused (Microsoft Entra ID sends none).
# The provider's issuer URL, exactly as its discovery document reports it, including
# any trailing slash. Auth0: https://YOUR-TENANT.us.auth0.com/
NEXUS_OIDC_ISSUER=
# The client ID of the single-page application registered with the provider. Public.
NEXUS_OIDC_CLIENT_ID=
# The audience the token must carry. The browser sends the provider's ID token, whose
# audience is the client ID, so this is normally the same value as NEXUS_OIDC_CLIENT_ID.
NEXUS_OIDC_AUDIENCE=
# Optional. Overrides the signing-key URL from the provider's discovery document.
NEXUS_OIDC_JWKS_URL=
# Optional. Default: openid email profile. Must include openid and email. Add
# offline_access if the provider should issue a refresh token so long sessions renew
# without a redirect (the refresh must return a new ID token for that to happen).
NEXUS_OIDC_SCOPES=

# ---------------------------------------------------------------- Optional features
# Each is off, and its endpoints answer "not configured", when unset.
# Recording encryption key: 64 hexadecimal characters (openssl rand -hex 32). Keep it
# outside the database and its backups; losing it makes saved recordings unreadable.
NEXUS_MEDIA_KEY_HEX=
# WebRTC ICE servers as a JSON array. Calls across networks need a TURN server.
NEXUS_ICE_SERVERS_JSON=
# Local speech recognition and saved-media transcription: absolute paths on the
# machine running the API. Not present in the hosted image.
NEXUS_WHISPER_CLI=
NEXUS_WHISPER_MODEL=
NEXUS_FFMPEG_CLI=
# Local drafting model (llama.cpp on loopback). Not present in the hosted image.
NEXUS_LLM_PORT=
NEXUS_LLM_ALIAS=
NEXUS_LLM_MODEL=
# Log level for the API process.
RUST_LOG=info

# ---------------------------------------------------------------- Frontend build (Vite)
# Leave unset. The browser then calls /api on its own origin, which the Vite proxy
# (local) and frontend/vercel.json (hosted) forward to the API. Set it only to make the
# browser call the API host directly, for example https://nexus-api.example.com
VITE_API_BASE_URL=
# Local development only: where the Vite proxy forwards /api.
NEXUS_API_PROXY=http://127.0.0.1:8090

# ---------------------------------------------------------------- Tests and evaluation only
# Disposable integration-test database. Must end in /nexus_test.
TEST_DATABASE_URL=postgres://nexus:nexus_local@127.0.0.1:55432/nexus_test
# Opt-in local drafting-model evaluation (see api/src/clinical_model/evaluation.rs).
NEXUS_LLM_EVAL=
NEXUS_LLM_EVAL_OUT=
# Telehealth browser QA fixture served by the Vite dev server.
NEXUS_TELEHEALTH_QA_FIXTURE=

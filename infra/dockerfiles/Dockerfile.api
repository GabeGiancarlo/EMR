# Build artifact only. Public serving requires the deferred identity boundary.
FROM rust:1.95-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY api ./api
COPY migrations ./migrations
RUN cargo build --locked --release -p emr-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && useradd --create-home nexus
WORKDIR /app
COPY --from=builder /app/target/release/emr-api /app/emr-api
USER nexus
ENV HOST=127.0.0.1 PORT=8090
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s CMD curl -f http://127.0.0.1:8090/healthz || exit 1
# NEXUS_LOCAL_DEV must be explicitly supplied. Never enable this on a public host.
CMD ["/app/emr-api"]

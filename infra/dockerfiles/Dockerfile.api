# Nexus API for a hosted, synthetic-data demonstration behind identity-provider sign-in.
# It starts in hosted mode (NEXUS_AUTH_MODE=oidc) and refuses to run until the
# variables in .env.example are set. It contains no speech or drafting models and no
# media key, so those features answer "not configured". Not for real patient data.
FROM rust:1.95-bookworm AS builder
# The JWT library's cryptography (aws-lc) is compiled from C; cmake covers targets
# where its default build needs it.
RUN apt-get update && apt-get install -y --no-install-recommends cmake && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY api ./api
COPY migrations ./migrations
RUN cargo build --locked --release -p emr-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && useradd --create-home nexus
WORKDIR /app
COPY --from=builder /app/target/release/emr-api /app/emr-api
USER nexus
# Hosted mode is the only mode allowed to listen on a public address. A container
# host that assigns its own PORT overrides the default here.
# RUST_LOG=info: refused sign-ins and provider problems are logged at info and warn;
# without it only errors would reach the host's log.
ENV NEXUS_AUTH_MODE=oidc HOST=0.0.0.0 PORT=8090 RUST_LOG=info
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fsS "http://127.0.0.1:${PORT}/healthz" || exit 1
CMD ["/app/emr-api"]
